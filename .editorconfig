# Team formatting baseline. Merge with an existing approved file during setup.
# This is editor guidance; it does not install or run a formatter or CI check.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 100

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces can represent an intentional Markdown line break.
trim_trailing_whitespace = false
max_line_length = off

[*.{bat,cmd}]
end_of_line = crlf
