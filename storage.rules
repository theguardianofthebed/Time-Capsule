
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function capsulePath(capsuleId) {
      return /databases/(default)/documents/capsules/$(capsuleId);
    }

    function capsuleExists(capsuleId) {
      return firestore.exists(capsulePath(capsuleId));
    }

    function capsuleData(capsuleId) {
      return firestore.get(capsulePath(capsuleId)).data;
    }

    // A photo is readable only when its published capsule
    // exists and the requester is an authorized participant.
    function canReadCapsule(senderUid, capsuleId) {
      return capsuleExists(capsuleId)
        && capsuleData(capsuleId).hasPhoto == true
        && capsuleData(capsuleId).photoPath
          == 'capsuleMedia/' + senderUid + '/' + capsuleId + '/original'
        && (
          (
            capsuleData(capsuleId).senderId == request.auth.uid
            && capsuleData(capsuleId).senderId
              != capsuleData(capsuleId).recipientId
          )
          ||
          (
            capsuleData(capsuleId).recipientId == request.auth.uid
            && capsuleData(capsuleId).unlocked == true
          )
        );
    }

    function validImageUpload() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png'
        ];
    }

    match /capsuleMedia/{senderUid}/{capsuleId}/original {

      // Upload is allowed before Firestore publication.
      // The sender can only create a photo under their own UID.
      allow create: if signedIn()
        && request.auth.uid == senderUid
        && resource == null
        && validImageUpload();

      // Reading requires a published capsule and the same
      // authorization as its protected text content.
      allow read: if signedIn()
        && canReadCapsule(senderUid, capsuleId);

      // Published photos cannot be replaced or deleted by clients.
      allow update, delete: if false;
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
