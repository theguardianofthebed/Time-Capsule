<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s03RootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/capsule_bg"
    android:orientation="vertical">

    <!-- Top Main Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnHeaderAccount"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_account"
            android:src="@drawable/ic_logout" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/s01_brand"
            android:textColor="@color/capsule_text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnHeaderRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/s08_btn_create_capsule"
            android:src="@drawable/ic_edit" />
    </LinearLayout>

    <!-- Intro Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/s03_eyebrow"
            android:textColor="@color/capsule_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/s03_headline"
            android:textColor="@color/capsule_text_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/s03_subtitle"
            android:textColor="@color/capsule_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Tabs: Received / Sent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnTabReceived"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/s03_tab_received"
            android:textColor="@color/capsule_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabSent"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/s03_tab_sent"
            android:textColor="@color/capsule_text_muted" />
    </LinearLayout>

    <!-- Stale / Offline Banner -->
    <TextView
        android:id="@+id/tvStaleBanner"
        android:accessibilityLiveRegion="polite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/capsule_banner_bg"
        android:padding="8dp"
        android:text="@string/s03_stale_banner"
        android:textAlignment="center"
        android:textColor="@color/capsule_banner_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Error Banner -->
    <TextView
        android:id="@+id/tvErrorMessage"
        android:accessibilityLiveRegion="polite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/capsule_error_bg"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="@color/capsule_error_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- List Area (Scrollable LinearLayout for dynamic item binding) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/llCapsuleListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Empty List Indicator -->
            <TextView
                android:id="@+id/tvEmptyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/s03_empty_received"
                android:textColor="@color/capsule_text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/capsule_card_surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/btnNavMoments"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_moments"
            android:textColor="@color/capsule_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavCreate"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_create"
            android:textColor="@color/capsule_text_muted" />

        <Button
            android:id="@+id/btnNavAccount"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_account"
            android:textColor="@color/capsule_text_muted" />
    </LinearLayout>

</LinearLayout>
