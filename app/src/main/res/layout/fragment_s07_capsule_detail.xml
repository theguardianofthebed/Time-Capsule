<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s07RootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/capsule_bg"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnS07Back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/s07_nav_title"
            android:textColor="@color/capsule_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvS07StatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_neutral"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/s07_badge_sealed"
                android:textColor="@color/capsule_text_body"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Headline & Meta -->
            <TextView
                android:id="@+id/tvS07Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/capsule_text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvS07Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/capsule_text_body"
                android:textSize="12sp" />

            <!-- Lock Condition Card ("MEANT TO OPEN") -->
            <LinearLayout
                android:id="@+id/llS07LockCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/s07_meant_to_open"
                    android:textColor="@color/capsule_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvS07LockCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/capsule_text_body"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Letter Content Card (Ruled) -->
            <LinearLayout
                android:id="@+id/llS07ContentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hero_envelope" />

                <TextView
                    android:id="@+id/tvS07BodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/capsule_text_dark"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivS07Photo"
                    android:contentDescription="@string/capsule_photo_description"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvS07SignOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/capsule_primary"
                    android:textSize="14sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Persistent verification, access and media status. -->
            <TextView
                android:id="@+id/tvS07Banner"
                android:accessibilityLiveRegion="polite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_banner_info"
                android:padding="12dp"
                android:textColor="@color/capsule_text_body"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Error / Retry Button -->
            <Button
                android:id="@+id/btnS07Retry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/s07_btn_retry"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbS07Loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/capsule_card_surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/btnS07NavMoments"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_moments"
            android:textColor="@color/capsule_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnS07NavCreate"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_create"
            android:textColor="@color/capsule_text_body" />

        <Button
            android:id="@+id/btnS07NavAccount"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_account"
            android:textColor="@color/capsule_text_body" />
    </LinearLayout>

</LinearLayout>
