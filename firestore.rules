rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Recipient directory rules for Issue #10
    match /recipientDirectory/{uid} {
      // Allow exact single-document get for authenticated users. Deny list queries.
      allow get: if request.auth != null;
      allow list: if false;

      // Allow owner to create or update their own profile document with non-empty displayName
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;

      allow delete: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
